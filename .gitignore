# ---------------------------------------------------------------------------
# Protected data. The LACME extract contains decedent names; the processed
# mentions table is one row per decedent per substance. Neither belongs in a
# repository. Both are regenerable or supplied by the operator.
#
# Do not add exceptions to these three rules.
# ---------------------------------------------------------------------------
data/raw/lacme/
data/processed/

# Nothing else under data/ is sensitive — the NFLIS catalog and the LA County
# zipcode boundaries are public and are committed deliberately.

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store

# Third-party TreeScan distribution (validation only, not our code).
# The tarball, the binary and its documents are Kulldorff's, redistributed
# under their own EULA -- do not commit them. Only our comparison scripts and
# the resulting numbers belong in git.
vendor/treescan/treescan64
vendor/treescan/treescan*.tar.gz
vendor/treescan/documents/
vendor/treescan/examples/
vendor/treescan/work/
